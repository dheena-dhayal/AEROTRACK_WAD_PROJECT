{
  "name": "aerotrack-pro",
  "version": "0.2.0",
  "private": true,
  "description": "AeroTrack Pro: Smart Airport Baggage Tracking System (MCA project, PSG College of Technology). Plain HTML, CSS and JavaScript client; Node.js, Express and MongoDB server.",
  "workspaces": [
    "shared-utils",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
    "start": "npm run start -w backend",
    "build": "echo \"No build step: the client is plain HTML, CSS and JavaScript served by the Node.js server.\"",
    "lint": "eslint .",
    "test": "node --test shared-utils/test/*.test.js backend/test/*.test.js",
    "test:shared": "npm test -w shared-utils",
    "test:backend": "npm test -w backend",
    "seed": "npm run seed -w backend",
    "seed:checkpoints": "npm run seed:checkpoints -w backend --",
    "set-role": "npm run set-role -w backend --",
    "create-user": "npm run create-user -w backend --",
    "db:check": "npm run db:check -w backend"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  },
  "type": "module"
}
